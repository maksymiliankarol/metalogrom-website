---
import Card from "./Card.astro";

interface Props {
  title: string;
  basePath: string;
  data: { slug: string; title: string; tagline: string }[];
}

const { title, basePath, data } = Astro.props;

// "/software" -> "software"
const id = basePath.replace(/^\//, "");
---

<section id={id} class="w-full flex justify-center pb-24 pt-8 scroll-mt-16">
  <div class="w-full max-w-5xl p-4 space-y-4">
    <h2 class="text-xl">{title}</h2>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-8">
      {data.map((item) => (
        <Card
          slug={item.slug}
          title={item.title}
          tagline={item.tagline}
          href={`${basePath}/${item.slug}`}
        />
      ))}
    </div>
  </div>
</section>