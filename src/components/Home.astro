---
import Layout from '../layouts/Layout.astro';
import { getPages, listPages } from '../data/pages';
import { languages } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import { langs, localePath, useTranslations } from '../i18n/utils';
import Hexagon from './Hexagon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const software = listPages(await getPages(), 'software', lang);
---

<Layout lang={lang}>
  <section class="page width-sm column gap-lg">
    <div class="column gap-sm">
      <div class="logo">
        <Hexagon size={42}/>
        <h1>Metalogrom</h1>
      </div>
      <p>{t('home.intro')}</p>
    </div>
    <div class="column gap-sm">
      <h3>{t('home.software')}</h3>
      <div>
        {software.map((item) => (
          <p>
            <a href={localePath(`/${item.path}`, lang)}>{item.title}</a>
            {" - "}{item.description}
          </p>
        ))}
      </div>
    </div>

    <div class="column gap-sm">
      <h3>{t('home.others')}</h3>
      <div>
        <p><a href="">{t('home.language')}</a></p>
        <p><a href="">{t('home.contact')}</a></p>
      </div>
    </div>
  </section>
</Layout>