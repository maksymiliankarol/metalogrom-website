---
import Logo from './Logo.astro';
import Layout from '../layouts/Layout.astro';
import { getPages, listPages } from '../data/pages';
import { languages } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import { langs, localePath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const software = listPages(await getPages(), 'software', lang);
---

<Layout {lang}>
  <Logo />
  <p class="intro">{t('home.intro')}</p>
  <hr />
  <section class="segment">
    <label>{t('home.software')}</label>
    <ul>
      {software.map((item) => (
        <li>
          <a href={localePath(`/${item.path}`, lang)}>{item.title}</a>
          {" - "}{item.description}
        </li>
      ))}
    </ul>
  </section>
  <hr />
  <section class="segment">
    <label>{t('home.language')}</label>
    <ul>
      {langs.map((l) => (
        <li>
          {l === lang ? (
            <strong aria-current="true">{languages[l].label}</strong>
          ) : (
            <a href={localePath("/", l)} hreflang={languages[l].hreflang}>{languages[l].label}</a>
          )}
        </li>
      ))}
    </ul>
  </section>
  <hr />
  <section class="segment">
    <label>{t('home.contact')}</label>
    <p>{t('home.write')} <a href="mailto:help@metalogrom.com">help@metalogrom.com</a></p>
  </section>
</Layout>