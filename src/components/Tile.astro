---
import { tileColors, type TileColor } from '../utils/tileColors';

interface Props {
  title: string;
  href: string;
  color?: TileColor;
  class?: string;
}

const { title, href, color = "none", class: className = "" } = Astro.props;
---

<a
  href={href}
  class:list={[
    "col-span-6 sm:col-span-4 md:col-span-3 aspect-square flex items-center justify-center text-2xl md:text-3xl cursor-pointer",
    "border-r-2 border-b-2 border-black",
    "hover:brightness-75 focus-visible:brightness-75 focus:outline-none",
    tileColors[color],
    className,
  ]}
>
  {title}
</a>