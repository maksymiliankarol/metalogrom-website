---
const contactLinks = [
	{ label: "hello@metalogrom.com", href: "mailto:hello@metalogrom.com" },
	{ label: "X (@metalogrom)", href: "https://x.com/metalogrom" },
	{ label: "Bluesky (@metalogrom.bsky.social)", href: "https://bsky.app/profile/metalogrom.bsky.social" },
];
---

<footer class="w-full py-18 border-t-2 border-neutral-300 flex flex-col gap-12 items-center justify-center">
	<div class="w-full max-w-5xl grid grid-cols-2 px-4">
		<div class="space-y-2 flex flex-col">
			<label class="uppercase font-bold opacity-50">Reach us</label>
			{contactLinks.map(({ label, href }) => (
				<a href={href} class="w-fit underline hover:decoration-2">
					{label}
				</a>
			))}
		</div>
		<div>
			{/* Nothing here for now */}
		</div>
	</div>
</footer>