---
import type { HTMLAttributes } from "astro/types"

export type ButtonVariant = "solid" | "outline" | "ghost" | "destructive"
export type ButtonSize = "small" | "normal" | "large"

type SharedProps = {
  variant?: ButtonVariant
  size?: ButtonSize
  icon?: boolean
  /** Force the active state. By default it's derived from the current URL (like NavLink). */
  current?: boolean
}

type ButtonAsButton = SharedProps &
  HTMLAttributes<"button"> & {
    href?: undefined
  }

type ButtonAsLink = SharedProps &
  HTMLAttributes<"a"> & {
    href: string
  }

export type Props = ButtonAsButton | ButtonAsLink

const base =
  "shrink-0 inline-flex items-center gap-2 border cursor-pointer transition " +
  "focus-visible:outline-hidden disabled:opacity-50 disabled:cursor-not-allowed"

const variants: Record<ButtonVariant, string> = {
  solid:
    "border-transparent bg-white/10 not-disabled:hover:brightness-80 " +
    "aria-[current=page]:bg-foreground/15 " +
    "focus-visible:bg-foreground/15 focus-visible:border-foreground/40",
  outline:
    "border-foreground/30 not-disabled:hover:bg-white/10 " +
    "aria-[current=page]:bg-foreground/15 " +
    "focus-visible:bg-foreground/15 focus-visible:border-foreground/40",
  ghost:
    "border-transparent not-disabled:hover:bg-white/10 " +
    "aria-[current=page]:bg-foreground/15 " +
    "focus-visible:bg-foreground/15 focus-visible:border-foreground/40",
  destructive:
    "border-error/70 bg-error/10 text-error not-disabled:hover:bg-error/30 " +
    "aria-[current=page]:bg-error/20 " +
    "focus-visible:bg-error/30 focus-visible:border-error",
}

const sizes: Record<ButtonSize, string> = {
  small: "px-3 py-1 text-sm",
  normal: "px-4 py-2 text-base",
  large: "px-6 py-3 text-lg",
}

const iconSizes: Record<ButtonSize, string> = {
  small: "size-7 justify-center text-sm [&>svg]:size-4 [&>svg]:shrink-0",
  normal: "size-10 justify-center text-base [&>svg]:size-6 [&>svg]:shrink-0",
  large: "size-13 justify-center text-lg [&>svg]:size-8 [&>svg]:shrink-0",
}

const {
  variant = "solid",
  size = "normal",
  icon = false,
  current,
  href,
  class: className,
  ...rest
} = Astro.props as SharedProps & { href?: string; class?: string } & Record<string, any>

// Mimics NavLink: exact match, or a parent path (except for "/").
const isCurrent =
  current ??
  (href !== undefined &&
    (href === "/"
      ? Astro.url.pathname === "/"
      : Astro.url.pathname === href ||
        Astro.url.pathname.startsWith(href.replace(/\/$/, "") + "/")))

const Tag = href !== undefined ? "a" : "button"
const attrs: Record<string, any> =
  href !== undefined
    ? { href, ...rest }
    : { type: "button" as const, ...rest } // default type, overridable via props
---

<Tag
  data-variant={variant}
  aria-current={isCurrent ? "page" : undefined}
  class:list={[base, variants[variant], icon ? iconSizes[size] : sizes[size], className]}
  {...attrs}
>
  <slot />
</Tag>