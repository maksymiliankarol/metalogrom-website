---
import { SITE_NAME, SITE_DESCRIPTION } from '../data/site';
import { defaultLang, languages } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import { langs, localePath, normalizePath, stripLang } from '../i18n/utils';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
}

const DEFAULT_IMAGE = '/og-default.png';
const DEFAULT_IMAGE_ALT = 'Metalogrom';

const {
  lang = defaultLang,
  title,
  description = SITE_DESCRIPTION,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  image = DEFAULT_IMAGE,
  imageAlt = DEFAULT_IMAGE_ALT,
  type = 'website',
} = Astro.props;

const abs = (p: string) => new URL(p, Astro.site).href;

// Homepage: just the site name. Other pages: "Page title | Metalogrom"
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const path = normalizePath(canonicalPath);
const canonicalURL = abs(path);
const imageURL = abs(image);

// hreflang: same page in every language (+ x-default -> default language)
const basePath = stripLang(path);
const alternates = langs.map((l) => ({
  hreflang: languages[l].hreflang,
  href: abs(localePath(basePath, l)),
}));
const xDefault = abs(localePath(basePath, defaultLang));
const otherLocales = langs.filter((l) => l !== lang).map((l) => languages[l].ogLocale);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
{!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
{!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<!-- Open Graph -->
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={languages[lang].ogLocale} />
{otherLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}

<!-- Twitter / X -->
<meta name="twitter:site" content="@metalogrom" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />