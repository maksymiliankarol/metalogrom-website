---
interface Props {
  slug: string;
  title: string;
  tagline: string;
  href: string;
}

const {
  slug,
  title,
  tagline,
  href,
} = Astro.props;

const logos = import.meta.glob<{ default: any }>("../assets/logos/*.svg", {
  eager: true,
});

const Logo = logos[`../assets/logos/${slug}.svg`]?.default;
---

<a
  href={href}
  class="group rounded-xl overflow-hidden divide-y-2 divide-neutral-300 border-2 border-neutral-300 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg active:translate-y-0.5 active:shadow-sm"
>
  <div class="p-4 pt-6 flex flex-col gap-3 items-center justify-center">
    {Logo && <Logo class="w-full h-10" />}
    <h3 class="text-xl">{title}</h3>
  </div>
  <div class="p-4">
    <p>{tagline}</p>
  </div>
</a>