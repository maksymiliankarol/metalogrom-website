---
import type { SvgComponent } from "astro/types";
import { textOn, type AppColor } from "../data/colors";

interface Props {
  href?: string;
  icon?: SvgComponent;
  text?: string;
  color?: AppColor;
  class?: string;
}

const { href, icon: Icon, text, color = "offblack", class: className } = Astro.props;
---

<a
  href={href}
  style={`background-color: var(--${color})`}
  class:list={[
    "col-span-6 sm:col-span-4 md:col-span-3 aspect-square flex flex-col gap-2 items-center justify-center border-2 border-black cursor-pointer hover:brightness-75",
    textOn(color),
    className,
  ]}
>
  {Icon && <Icon class="size-12 md:size-14" />}
  {text && <span class="text-xl md:text-2xl">{text}</span>}
</a>