---
import type { HTMLAttributes } from "astro/types"

export interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...rest } = Astro.props
---

<div class="@container">
  <div
    class:list={[
      "grid gap-2 [--gap:0.5rem]",
      "grid-cols-2 [--cols:2]",
      "sm:grid-cols-3 sm:[--cols:3]",
      "md:grid-cols-5 md:[--cols:5]",
      "lg:grid-cols-6 lg:[--cols:6]",
      "auto-rows-[calc((100cqw-(var(--cols)-1)*var(--gap))/var(--cols))]",
      className,
    ]}
    {...rest}
  >
    <slot />
  </div>
</div>