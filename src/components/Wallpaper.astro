---
type WallpaperVariant = "glow" | "beams" | "discs" | "rings" | "wedge"

export interface Props {
  /** One variant or several stacked. Default: "discs" */
  variant?: WallpaperVariant | WallpaperVariant[]
  /** Same seed = same wallpaper. */
  seed?: string | number
  /** Main hue, 0-360. Default 255 (blue). */
  hue?: number
  /** Hue offset between the two ends of the base gradient. Default 25. */
  hueShift?: number
  /** Color intensity, 0-0.3. Lower = more neutral. Default 0.15. */
  chroma?: number
  /** Lightness offset for both gradient ends, about -0.35 (near black) to 0.2. Default 0. */
  lightness?: number
  /** Shapes per variant. Default 4. */
  count?: number
  /** Shape size multiplier. Default 1. */
  scale?: number
  /** Edge softness, 0 (crisp) to 1 (blurred). Default 0. */
  softness?: number
}

/* ---------- Constants (dark theme only) ---------- */

const L_BASE = 0.36
const L_DEEP = 0.2
const LIGHT = "oklch(1 0 0 / 0.05)"
const DARK = "oklch(0 0 0 / 0.25)"

/* ---------- Seeded random ---------- */

function hashSeed(seed: string | number): number {
  const s = String(seed)
  let h = 1779033703 ^ s.length
  for (let i = 0; i < s.length; i++) {
    h = Math.imul(h ^ s.charCodeAt(i), 3432918353)
    h = (h << 13) | (h >>> 19)
  }
  h = Math.imul(h ^ (h >>> 16), 2246822507)
  h = Math.imul(h ^ (h >>> 13), 3266489909)
  return (h ^ (h >>> 16)) >>> 0
}

function mulberry32(a: number) {
  return () => {
    a = (a + 0x6d2b79f5) | 0
    let t = Math.imul(a ^ (a >>> 15), 1 | a)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
}

const n = (v: number) => +v.toFixed(2)
const clamp = (v: number, min: number, max: number) =>
  Math.min(max, Math.max(min, v))

/* ---------- Layer builders ---------- */
/* Each returns an array of CSS gradient strings. */

interface LayerOptions {
  rng: () => number
  count: number
  scale: number
  softness: number
  angle: number
  hue: number
  hueShift: number
  chroma: number
}

const BUILDERS: Record<WallpaperVariant, (o: LayerOptions) => string[]> = {
  // Large soft colored glows anchored near corners/edges
  glow: ({ rng, count, hue, hueShift, chroma }) =>
    Array.from({ length: clamp(count, 2, 4) }, () => {
      const x = rng() < 0.5 ? rng() * 25 : 75 + rng() * 25
      const y = rng() < 0.5 ? rng() * 25 : 75 + rng() * 25
      const w = 50 + rng() * 30
      const h = 60 + rng() * 30
      const l = 0.55 + rng() * 0.3
      const offset = (rng() * 2 - 1) * Math.max(hueShift, 20) * 1.4
      const alpha = 0.35 + rng() * 0.25
      const color = `oklch(${n(l)} ${n(chroma * 1.2)} ${n(hue + offset)} / ${n(alpha)})`
      return `radial-gradient(${n(w)}% ${n(h)}% at ${n(x)}% ${n(y)}%, ${color}, transparent 65%)`
    }),

  // Hard-edged circles
  discs: ({ rng, count, scale, softness }) => {
    const soft = 0.2 + softness * 14
    return Array.from({ length: count }, () => {
      const x = rng() * 100
      const y = rng() * 100
      const r = (8 + rng() * 24) * scale
      const color = rng() > 0.45 ? LIGHT : DARK
      return `radial-gradient(circle at ${n(x)}% ${n(y)}%, ${color} 0 ${n(r)}%, transparent ${n(r + soft)}%)`
    })
  },

  // Diagonal stripes
  beams: ({ rng, count, scale, softness, angle }) => {
    const feather = softness * 10
    return Array.from({ length: count }, () => {
      const start = rng() * 75
      const end = start + (6 + rng() * 22) * scale
      const a = angle + 20 + (rng() * 2 - 1) * 8
      const color = rng() > 0.4 ? LIGHT : DARK
      return `linear-gradient(${n(a)}deg, transparent ${n(start - feather)}%, ${color} ${n(start)}% ${n(end)}%, transparent ${n(end + feather)}%)`
    })
  },

  // Concentric rings sharing one center
  rings: ({ rng, count, scale, softness }) => {
    const cx = 20 + rng() * 60
    const cy = 20 + rng() * 60
    const feather = softness * 4
    return Array.from({ length: count }, (_, i) => {
      const r = (8 + (i / Math.max(count, 1)) * 60 + rng() * 6) * scale
      const t = (1.5 + rng() * 5) * scale
      const color = rng() > 0.4 ? LIGHT : DARK
      return `radial-gradient(circle at ${n(cx)}% ${n(cy)}%, transparent ${n(r - feather)}%, ${color} ${n(r)}% ${n(r + t)}%, transparent ${n(r + t + feather)}%)`
    })
  },

  // Diagonal fold tinting one side
  wedge: ({ rng, count, softness, angle }) => {
    const feather = softness * 12
    return Array.from({ length: clamp(count, 1, 3) }, () => {
      const p = 25 + rng() * 55
      const a = angle + (rng() * 2 - 1) * 25
      const color = rng() > 0.5 ? LIGHT : DARK
      return `linear-gradient(${n(a)}deg, transparent ${n(p - feather)}%, ${color} ${n(p + feather)}%)`
    })
  },
}

/* ---------- Component logic (runs at build/render time, ships no JS) ---------- */

const {
  variant = "discs",
  seed = "metro",
  hue = 255,
  hueShift = 25,
  chroma = 0.15,
  lightness = 0,
  count = 4,
  scale = 1,
  softness = 0,
} = Astro.props

const angle = 120 + mulberry32(hashSeed(seed))() * 50
const variants = Array.isArray(variant) ? variant : [variant]

const shapes = variants.flatMap((v) =>
  BUILDERS[v]({
    // Per-variant RNG: reordering variants doesn't change each one's look
    rng: mulberry32(hashSeed(`${seed}:${v}`)),
    count,
    scale,
    softness: clamp(softness, 0, 1),
    angle,
    hue,
    hueShift,
    chroma,
  }),
)

const lBase = n(clamp(L_BASE + lightness, 0, 1))
const lDeep = n(clamp(L_DEEP + lightness, 0, 1))
const base = `linear-gradient(${n(angle)}deg, oklch(${lBase} ${chroma} ${hue}), oklch(${lDeep} ${chroma} ${hue + hueShift}))`

const style = `background-color:oklch(${lDeep} ${n(chroma * 0.8)} ${hue});background-image:${[...shapes, base].join(", ")}`
---

<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10"
  style={style}
>
</div>