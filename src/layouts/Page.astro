---
import type { ComponentProps } from "astro/types";
import Layout from "./Layout.astro";
import Wallpaper from "../components/Wallpaper.astro";

// Accept exactly the same props as Layout (title, description, canonicalPath, ...)
type Props = ComponentProps<typeof Layout>;

const props = Astro.props;
---

<Layout {...props}>
  <main class="relative isolate min-h-dvh w-full flex justify-center overflow-auto">
    <Wallpaper
      variant="discs"
      hue={250}
      hueShift={20}
      chroma={0.05}
      softness={0.4}
      lightness={-0.06}
      count={2}
      intensity={0.2}
      grain={0.05}
    />
    <slot />
  </main>
</Layout>