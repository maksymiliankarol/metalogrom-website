---
import { apps } from "../data/apps";
import type { App } from "../data/apps";
import Page from "../layouts/Page.astro";
import ArrowBack from "../assets/icons/arrow-back.svg";
import { buttonColors } from "../utils/buttonColor";

export function getStaticPaths() {
  return apps.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: App;
}

const { item } = Astro.props;
const colorClasses = buttonColors[item.color ?? "none"];
---

<Page title={item.title} description={item.description}>
  <div class="w-full max-w-lg mx-auto flex flex-col gap-4">
    <a href="/" class="inline-flex items-center gap-2 underline hover:decoration-2 self-start md:pt-8">
      <ArrowBack />
      <span>Back</span>
    </a>
    <h1 class="text-4xl md:text-6xl md:pt-8 pt-4">{item.title}</h1>
    <p class="pb-8 pt-4">{item.description}</p>
    <a
      href={item.url}
      class:list={[colorClasses, "px-4 py-2 border-2 border-black w-fit cursor-pointer hover:brightness-75"]}
    >
      Get Started
    </a>
  </div>
</Page>