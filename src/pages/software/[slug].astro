---
import Page from "../../layouts/Page.astro";
import { software } from "../../data/software";
import type { Software } from "../../data/software";
import ArrowBack from "../../assets/icons/arrow-back.svg"

export function getStaticPaths() {
  return software.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: Software;
}

const { item } = Astro.props;
---

<Page>
  <div class="w-full max-w-2xl space-y-16 p-4 md:py-16">
    <div class="mx-auto bg-background/20 border border-foreground/10 h-full">
      <header class="p-4 bg-background/30">
        <a href="/#software" class="group flex items-center gap-2 underline hover:decoration-2 cursor-pointer">
          <ArrowBack />
          <span>All software</span>
        </a>
      </header>
      <section class="p-4 py-8 space-y-8">
        <h1 class="text-4xl">
          {item.title}
        </h1>
        <p>
          {item.description}
        </p>
        <button>
          Get started
        </button>
      </section> 
    </div> 
  </div>
</Page>