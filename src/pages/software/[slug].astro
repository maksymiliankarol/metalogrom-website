---
import Page from "../../layouts/Page.astro";
import { software } from "../../data/software";
import type { Software } from "../../data/software";
import ChevronLeft from "../../assets/icons/chevron-left.svg"
import Card from "../../components/Card.astro";
import Warning from "../../assets/icons/warning.svg"
import Button from "../../components/Button.astro";

export function getStaticPaths() {
  return software.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: Software;
}

const { item } = Astro.props;
---

<Page>
  <div class="w-full max-w-xl space-y-16 p-4 md:py-16">
    <div class="mx-auto h-full flex flex-col gap-6">
      <Button 
        href="/#software" 
        variant="ghost"
        class="w-fit"
      >
        <ChevronLeft />
        All Software
      </Button>

      <div class="grid grid-cols-3">
        <Card 
          class="col-span-3 aspect-2/1! md:aspect-3/1!"
          href={item.appUrl}
          icon={Warning}
          label={item.title}
          color="indigo"
        />
      </div>
      <p class="text-foreground/60">{item.description}</p>
      <Button class="justify-center">
        Get Started
      </Button>
    </div> 
  </div>
</Page>