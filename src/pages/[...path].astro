---
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getPages, pageTitle, parentPath, pickEntry } from '../data/pages';
import { defaultLang } from '../i18n/ui';
import { langs, localePath, useTranslations } from '../i18n/utils';

export async function getStaticPaths() {
  const pages = await getPages();

  return langs.flatMap((lang) =>
    [...pages.keys()].map((path) => ({
      // English has no prefix: "software/deals", Polish: "pl/software/deals"
      params: { path: lang === defaultLang ? path : `${lang}/${path}` },
      props: {
        lang,
        entry: pickEntry(pages, path, lang)!,
        title: pageTitle(pages, path, lang),
        backHref: localePath(`/${parentPath(pages, path)}`, lang),
      },
    }))
  );
}

const { lang, entry, title, backHref } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
---

<Layout {lang} {title} description={entry.data.description}>
  <div class="page width-md column gap-md">
    <p><a href={backHref}>{t("nav.back")}</a></p>
    <h1>{entry.data.title}</h1>
    <Content />
  </div>
</Layout>