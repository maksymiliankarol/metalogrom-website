---
import ChildPage from "../layouts/ChildPage.astro";
---

<ChildPage>
  <h1 class="text-4xl">Contact</h1>
  <p class="text-foreground/60">
    Questions, feedback, or ideas? We'd love to hear from you.
  </p>
  <p class="text-foreground/60">
    Write to us at
    <a
      href="mailto:help@metalogrom.com"
      class="underline hover:decoration-2 text-foreground px-2"
    >help@metalogrom.com</a>
    and we'll get back to you as soon as we can.
  </p>
</ChildPage>