---
import Page from "../layouts/Page.astro";
import ArrowBack from "../assets/icons/arrow-back.svg";
---

<Page>
  <div class="w-full max-w-lg mx-auto p-8 min-h-full flex flex-col border-2 border-black">
    <a href="/" class="inline-flex items-center gap-2 underline hover:decoration-2 self-start">
      <ArrowBack />
      <span>Back</span>
    </a>
    <h1 class="font-heading text-3xl sm:text-4xl pt-8">Contact</h1>
    <p class="text-lg pt-4">
      Write us:
      <a class="underline hover:decoration-2" href="mailto:help@metalogrom.com">help@metalogrom.com</a>
    </p>
  </div>
</Page>