---
import { software, getDescription } from "../../data/software";
import type { Software } from "../../data/software";
import Layout from "../../layouts/Layout.astro";
import { langs, getLang, getLangPaths, localePath, useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  const reserved: string[] = [...langs, "contact"];

  for (const item of software) {
    if (reserved.includes(item.slug)) {
      throw new Error(`Software slug "${item.slug}" collides with a locale code or a fixed page.`);
    }
  }

  return getLangPaths().flatMap(({ params }) =>
    software.map((item) => ({
      params: { ...params, slug: item.slug },
      props: { item },
    }))
  );
}

interface Props {
  item: Software;
}

const { item } = Astro.props;
const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);
const description = getDescription(item, lang);
---

<Layout {lang} title={item.name} description={description}>
  <p><a href={localePath('/', lang)}>{t('nav.back')}</a></p>
  <section class="individual">
    <h1>{item.name}</h1>
    <p>{description}</p>
    <p><a href={item.url}>{t('software.getStarted')}</a></p>
  </section>
</Layout>