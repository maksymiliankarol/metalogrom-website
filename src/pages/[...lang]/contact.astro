---
import { getLang, getLangPaths, localePath, useTranslations } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return getLangPaths();
}

const lang = getLang(Astro.params.lang);
const t = useTranslations(lang);
---

<Layout {lang}>
  <div>
    <a href={localePath('/', lang)} class="inline-flex items-center gap-2 underline hover:decoration-2 self-start md:pt-8">
      <span>{t('nav.back')}</span>
    </a>
    <p>
      {t('contact.write')}{" "}
      <a href="mailto:help@metalogrom.com">help@metalogrom.com</a>
    </p>
  </div>
</Layout>