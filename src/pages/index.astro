---
import Page from "../layouts/Page.astro";
---

<Page>
  <div class="w-full max-w-3xl mx-auto space-y-8 py-8 md:py-12">
    <h1 class="font-heading text-2xl sm:text-3xl md:text-4xl">
      Metalogrom is a family of products and services built to help people get everyday work done and have fun.
    </h1>
    <div class="grid grid-cols-2 md:grid-cols-4 auto-rows-32 gap-4 grid-flow-dense">
      <a href="/deals" class="col-span-2 md:row-span-2 text-2xl md:text-5xl bg-yellow text-offblack flex items-center justify-center border-2 border-black hover:brightness-75">
        Deals
      </a>
      <a href="/herds" class="col-span-2 text-2xl md:text-3xl bg-red text-white border-2 border-black flex items-center justify-center hover:brightness-75">
        Herds
      </a>
      <a href="/contact" class="bg-white text-xl border-2 border-black flex items-center justify-center hover:brightness-75">
        Contact
      </a>
    </div>
  </div>
</Page>