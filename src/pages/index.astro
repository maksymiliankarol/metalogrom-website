---
import Page from "../layouts/Page.astro";
import Tile from "../components/Tile.astro";
import { apps } from "../data/apps";
---

<Page>
  <div class="w-full max-w-3xl mx-auto space-y-8 py-8 md:py-12">
    <h1 class="font-heading text-2xl sm:text-3xl md:text-4xl">
      Metalogrom is a family of products and services built to help people get everyday work done and have fun.
    </h1>
    <div class="border-2 border-black overflow-hidden">
      <section class="grid grid-cols-12 -mr-0.5 -mb-0.5">
        {apps.map(({ slug, title, color }) => (
          <Tile title={title} href={`/${slug}`} color={color} />
        ))}
        <Tile title="Contact" href="/contact" color="offblack" />
      </section>
    </div>
  </div>
</Page>